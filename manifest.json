{
  "manifest_version": 3,
  "name": "DebtRead",
  "version": "1.3.2",
  "description": "Track your reading debt. Save articles, estimate reading time, highlight and manage your personal reading queue — fully local.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "DebtRead"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "reader/*",
        "src/*",
        "styles/*",
        "libs/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
